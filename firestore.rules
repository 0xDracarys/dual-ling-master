rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isTeacher() {
      return hasRole('teacher') || isAdmin();
    }
    
    // ==============================================
    // USERS COLLECTION
    // ==============================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // SECURITY (pentest F-01): privileged fields must never be writable by
      // the document owner. Previously `allow write` let any user set their
      // own role to 'admin'. Role, AI access and Google tokens are managed
      // only by admins / server-side code (Admin SDK bypasses these rules).
      allow create: if isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.role in ['student', 'teacher'] &&
         !('aiEnabled' in request.resource.data) &&
         !('googleTokens' in request.resource.data));
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['role', 'aiEnabled', 'googleTokens']));
      allow delete: if isAdmin();
      
      // Subcollections
      match /enrollments/{enrollmentId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /progress/{progressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /quizAttempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }
    }
    
    // ==============================================
    // COURSES COLLECTION
    // ==============================================
    match /courses/{courseId} {
      allow read: if resource.data.isPublished == true || 
                     isOwner(resource.data.teacherId) || 
                     isAdmin();
      
      allow create: if isTeacher();
      allow update, delete: if isOwner(resource.data.teacherId) || isAdmin();
      
      // Subcollection: Lessons
      match /lessons/{lessonId} {
        allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true ||
                       isOwner(get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId) ||
                       isAdmin();
        
        allow write: if isOwner(get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId) ||
                        isAdmin();
        
        // Subcollection: Quizzes
        match /quizzes/{quizId} {
          allow read: if get(/databases/$(database)/documents/courses/$(courseId)).data.isPublished == true ||
                         isOwner(get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId) ||
                         isAdmin();
          
          allow write: if isOwner(get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId) ||
                          isAdmin();
        }
      }
    }
    
    // ==============================================
    // ENROLLMENTS COLLECTION
    // ==============================================
    match /enrollments/{enrollmentId} {
      allow read: if isOwner(resource.data.userId) ||
                     isOwner(get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId) ||
                     isAdmin();
      
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // ==============================================
    // ADMIN-ONLY COLLECTIONS
    // ==============================================
    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // ==============================================
    // SERVER-ONLY COLLECTIONS (pentest F-06/F-11)
    // Google OAuth tokens and OAuth state nonces live here.
    // No client access at all — only server code via the Admin SDK,
    // which bypasses these rules.
    // ==============================================
    match /userSecrets/{userId} {
      allow read, write: if false;
    }
    
    match /oauthStates/{stateId} {
      allow read, write: if false;
    }
  }
}
